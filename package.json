{
  "name": "snk-assistant",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "prisma generate && prisma migrate deploy && next dev --hostname 127.0.0.1 --port 3100",
    "build": "prisma generate && next build",
    "seed": "node scripts/seed-profile.mjs",
    "lint": "eslint",
    "test:sql": "node --test --disable-warning=MODULE_TYPELESS_PACKAGE_JSON \"src/lib/sql/__tests__/*.test.mjs\"",
    "typecheck": "next typegen && tsc --noEmit"
  },
  "dependencies": {
    "@base-ui/react": "^1.9.0",
    "@codemirror/lang-sql": "^6.10.0",
    "@dnd-kit/react": "0.5.1",
    "@prisma/adapter-pg": "^7.10.1",
    "@prisma/client": "^7.10.1",
    "@tanstack/react-table": "^9.2.4",
    "@tanstack/react-virtual": "^3.14.13",
    "@uiw/react-codemirror": "^4.25.12",
    "class-variance-authority": "^0.7.1",
    "cn": "^0.5.0",
    "downshift": "^9.4.0",
    "lucide-react": "1.64.0",
    "next": "16.3.6",
    "pg": "^8.23.1",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "shadcn": "^4.23.0",
    "sonner": "^2.0.8",
    "sql-formatter": "^15.9.0",
    "tw-animate-css": "^1.4.0",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/pg": "^8.23.1",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.3.6",
    "prisma": "^7.10.1",
    "tailwindcss": "^4",
    "typescript": "^5"
  },
  "packageManager": "pnpm@12.6.0"
}
