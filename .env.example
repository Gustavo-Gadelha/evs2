# Copie para .env e preencha. Nunca use o prefixo NEXT_PUBLIC_: estes valores ficam só no servidor.
# O compose.yaml lê este arquivo; o `pnpm dev` também (via DATABASE_URL).

# Postgres do compose. Use uma senha só com letras e números (ela entra na DATABASE_URL abaixo).
POSTGRES_USER=assistant
POSTGRES_PASSWORD=troque-esta-senha
POSTGRES_DB=assistant
lPOSTGRES_PORT=5432

# Só para `pnpm dev` e para os comandos do Prisma rodados no host; no container o compose monta a sua.
# Mantenha usuário, senha, porta e banco iguais aos acima.
DATABASE_URL=postgresql://assistant:troque-esta-senha@127.0.0.1:5432/assistant

# Chave AES-256 (32 bytes em base64) que cifra os segredos dos perfis no banco. Gere com:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# Trocá-la invalida os perfis já salvos; guarde-a fora do banco e do repositório.
ENCRYPTION_KEY=

# Assistente de IA (Ollama local). Os padrões vêm do preset; qualquer AI_* preenchida abaixo os sobrescreve.
#   gpu = desktop (RTX 3060 Ti): qwen3:8b, contexto 8192.   cpu = notebook sem GPU: qwen3:4b, contexto 4096.
AI_PRESET=gpu
# Endereço do Ollama para o `pnpm dev` (no host); no container o compose usa http://ollama:11434.
OLLAMA_BASE_URL=http://127.0.0.1:11434
# Opcionais (em branco = padrão do preset). O modelo precisa ter a capacidade `tools` (confira com `ollama show`).
AI_CHAT_MODEL=
# Modo de raciocínio do Qwen3: mantenha false (proibitivo na CPU).
AI_THINK=
# Use o MESMO modelo de embeddings nas duas máquinas: o índice gerado em uma só serve na outra se ele coincidir.
AI_EMBED_MODEL=
AI_NUM_CTX=
# Tabelas recuperadas por pergunta, colunas por tabela enviadas ao modelo, voltas do agente e tentativas de correção.
AI_TOP_TABLES=
AI_MAX_COLUMNS_PER_TABLE=
AI_MAX_STEPS=
AI_MAX_FIX_ATTEMPTS=
AI_TIMEOUT_MS=

# Arquivos do compose. Desktop com GPU: os dois (o separador é `;` no Windows e `:` no Linux/macOS, ou defina
# COMPOSE_PATH_SEPARATOR). Notebook: só o compose.yaml. Para medir o preset cpu no desktop: compose.yaml;compose.cpu.yaml.
COMPOSE_FILE=compose.yaml;compose.gpu.yaml

# Perfil padrão do Sankhya (opcional). Só vale se as 6 variáveis estiverem preenchidas; deixe todas em branco para cadastrar
# os perfis pela tela. `pnpm seed` cria o perfil (ou atualiza o de mesmo nome) no banco, com os segredos cifrados.
# Roda no host, com o Postgres no ar; o compose não repassa estas variáveis ao container.
SANKHYA_PROFILE_NAME=
SANKHYA_PROFILE_BASE_URL=
SANKHYA_PROFILE_APPKEY=
SANKHYA_PROFILE_TOKEN=
SANKHYA_PROFILE_USERNAME=
SANKHYA_PROFILE_PASSWORD=
