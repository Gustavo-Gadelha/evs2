# Copie para .env e preencha. Nunca use o prefixo NEXT_PUBLIC_: estes valores ficam só no servidor.
# O compose.yaml lê este arquivo; o `pnpm dev` também (via DATABASE_URL).

# Postgres do compose. Use uma senha só com letras e números (ela entra na DATABASE_URL abaixo).
POSTGRES_USER=assistant
POSTGRES_PASSWORD=troque-esta-senha
POSTGRES_DB=assistant
# Porta do Postgres no host (só em 127.0.0.1), usada pelo `pnpm dev`.
POSTGRES_PORT=5432

# Só para `pnpm dev` e para os comandos do Prisma rodados no host; no container o compose monta a sua.
# Mantenha usuário, senha, porta e banco iguais aos acima.
DATABASE_URL=postgresql://assistant:troque-esta-senha@127.0.0.1:5432/assistant

# Chave AES-256 (32 bytes em base64) que cifra os segredos dos perfis no banco. Gere com:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# Trocá-la invalida os perfis já salvos; guarde-a fora do banco e do repositório.
ENCRYPTION_KEY=
