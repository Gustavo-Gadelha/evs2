generator client {
  provider = "prisma-client"
  output   = "../src/lib/db/generated"
}

datasource db {
  provider = "postgresql"
}

// `state` (QueryState) e `result` (QueryResult) são jsonb: o banco consegue filtrar por dentro deles.
model HistoryEntry {
  id        String   @id
  createdAt DateTime @default(now())
  sql       String
  state     Json
  manual    Boolean
  // null quando a execução falhou.
  rowCount  Int?
  error     String?
  // null quando falhou ou passou de MAX_RESULT_BYTES.
  result    Json?

  @@index([createdAt])
}

model SavedQuery {
  id      String   @id
  name    String
  savedAt DateTime @default(now())
  sql     String
  state   Json
  manual  Boolean

  @@index([savedAt])
}

// `secret` guarda appkey, token, usuário e senha como JSON cifrado (AES-256-GCM, ver `src/lib/db/crypto.ts`).
model Profile {
  id        String   @id
  name      String   @unique
  baseUrl   String
  secret    String
  createdAt DateTime @default(now())
}

// Chave/valor para o estado do app; hoje só `activeProfileId`.
model AppSetting {
  key   String @id
  value String
}

// Índice do dicionário para o assistente (RAG). Pertence ao ERP (base URL normalizada), não ao perfil.
// Inserção e busca são SQL cru parametrizado (ver `src/features/assistant/server/index-store.ts`).
model AiIndex {
  erpKey     String   @id
  // Modelo e dimensão dos vetores: a busca recusa se não baterem com `AI_EMBED_MODEL`.
  embedModel String
  dimension  Int
  builtAt    DateTime
  // O dicionário foi atualizado depois da última indexação.
  stale      Boolean  @default(false)
}

// `kind`: table | column | query. `ref`: tabela, `TABELA.COLUNA` ou id da consulta salva.
model AiDocument {
  id        String                 @id
  erpKey    String
  kind      String
  ref       String
  title     String
  content   String
  embedding Unsupported("vector")

  @@unique([erpKey, kind, ref])
  @@index([erpKey, kind])
}
